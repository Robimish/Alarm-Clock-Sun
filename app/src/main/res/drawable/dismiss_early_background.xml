	xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">

	<solid android:color="#22FFFFFF" />
	<stroke android:width="1dp" android:color="#66FFFFFF" />
	<corners android:radius="@dimen/tiny" />

</shape>
