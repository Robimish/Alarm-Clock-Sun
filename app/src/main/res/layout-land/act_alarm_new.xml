<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	style="@style/My.Alarm.Active.Parent"
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/act_alarm"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	tools:ignore="UseCompoundDrawables">

	<!-- Time -->
	<TextView
		style="@style/My.Alarm.Active.Time"
		android:id="@+id/current_time"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text=""
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toStartOf="@id/current_meridian"
		app:layout_constraintHorizontal_chainStyle="packed"
		/>

	<TextView
		style="@style/My.Alarm.Active.Meridian"
		android:id="@+id/current_meridian"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text=""
		app:layout_constraintStart_toEndOf="@id/current_time"
		app:layout_constraintBaseline_toBaselineOf="@id/current_time"
		app:layout_constraintEnd_toEndOf="parent"
		/>

	<!-- Clock with hands, shown instead of the digits when the alarm asks for it.
		It takes the place of the digits, at the top and in the middle, smaller than
		in portrait since the screen is short this way round -->
	<com.nfcalarmclock.view.NacAnalogClockView
		android:id="@+id/current_analog_clock"
		android:layout_width="@dimen/analog_clock_size_land"
		android:layout_height="@dimen/analog_clock_size_land"
		android:layout_marginTop="@dimen/analog_clock_top_land"
		android:visibility="gone"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		/>

	<!-- Whichever clock is shown, the date sits to its left, level with its bottom.
		Gone views are left out, so the barriers follow the one that is there -->
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/clock_start_barrier"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:barrierDirection="start"
		app:barrierAllowsGoneWidgets="false"
		app:constraint_referenced_ids="current_time,current_analog_clock"
		/>

	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/clock_bottom_barrier"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:barrierDirection="bottom"
		app:barrierAllowsGoneWidgets="false"
		app:constraint_referenced_ids="current_meridian,current_analog_clock"
		/>

	<!-- Date -->
	<TextView
		style="@style/My.Alarm.Active.Date"
		android:id="@+id/current_date"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text=""
		app:layout_constraintBottom_toBottomOf="@id/clock_bottom_barrier"
		app:layout_constraintEnd_toStartOf="@id/clock_start_barrier"
		/>

	<!-- Alarm name -->
	<TextView
		style="@style/My.Alarm.Active.Name"
		android:id="@+id/alarm_name"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:text=""
		app:layout_constraintTop_toBottomOf="@id/current_date"
		/>

	<!-- Dawn phrase, shown only while the sunrise is running. Hidden it takes no room
		and gives up its margin, so what follows sits exactly where it did before -->
	<TextView
		android:id="@+id/dawn_phrase"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/tiny"
		android:paddingStart="@dimen/large"
		android:paddingEnd="@dimen/large"
		android:gravity="center_horizontal"
		android:textSize="16sp"
		android:text=""
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@id/alarm_name"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		/>

	<!-- Scan NFC -->
	<LinearLayout
		android:id="@+id/scan_nfc_view"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="horizontal"
		android:visibility="invisible"
		android:animateLayoutChanges="true"
		app:layout_constraintTop_toBottomOf="@id/dawn_phrase"
		app:layout_constraintBottom_toTopOf="@id/slider_instructions">


		<ImageView
			style="@style/My.Alarm.Active.ScanNfc.Icon"
			android:id="@+id/scan_nfc_icon"
			android:contentDescription="@string/cd_scan_nfc"
			android:src="@drawable/tap_and_play"
			/>

		<TextView
			style="@style/My.Alarm.Active.ScanNfc.Text"
			android:id="@+id/scan_nfc_text"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text=""
			/>
	</LinearLayout>

	<!-- Slider instructions -->
	<TextView
		style="@style/My.Alarm.Active.SliderInstructions"
		android:id="@+id/slider_instructions"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:text=""
		app:layout_constraintBottom_toTopOf="@id/number_of_snoozes_left_message"
		app:layout_goneMarginBottom="@dimen/twoline"
		/>

	<!-- Number of snoozes left -->
	<TextView
		style="@style/My.Alarm.Active.NumberOfSnoozesLeft"
		android:id="@+id/number_of_snoozes_left_message"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:text=""
		android:visibility="gone"
		app:layout_constraintBottom_toTopOf="@id/alarm_action_row"
		/>

	<!-- Snooze/dismiss -->
	<RelativeLayout
		style="@style/My.Alarm.Active.SnoozeDismissRow"
		android:id="@+id/alarm_action_row"
		app:layout_constraintBottom_toTopOf="@id/music_and_warning_container"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<!-- Slider -->
		<RelativeLayout
			android:id="@+id/alarm_action_slider_path"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@drawable/slider_path"
			android:visibility="invisible">

			<ImageView
				style="@style/My.Alarm.Active.SliderArrow"
				android:id="@+id/slider_center_arrow"
				android:layout_centerVertical="true"
				android:layout_centerHorizontal="true"
				android:contentDescription="@string/cd_alarm_slider_arrow"
				/>

			<ImageView
				style="@style/My.Alarm.Active.SliderArrow.Left"
				android:id="@+id/slider_left_arrow"
				android:layout_centerVertical="true"
				android:layout_toStartOf="@id/slider_center_arrow"
				android:contentDescription="@string/cd_alarm_slider_arrow"
				/>

			<ImageView
				style="@style/My.Alarm.Active.SliderArrow.Right"
				android:id="@+id/slider_right_arrow"
				android:layout_centerVertical="true"
				android:layout_toEndOf="@id/slider_center_arrow"
				android:contentDescription="@string/cd_alarm_slider_arrow"
				/>
		</RelativeLayout>

		<!-- Snooze animation -->
		<RelativeLayout
			style="@style/My.Alarm.Active.SnoozeDismissButton"
			android:id="@+id/snooze_attention_view"
			android:layout_alignTop="@id/snooze_view"
			android:layout_alignStart="@id/snooze_view"
			android:alpha="0.3"
			android:backgroundTint="@color/white"
			/>

		<!-- Dismiss animation -->
		<RelativeLayout
			style="@style/My.Alarm.Active.SnoozeDismissButton"
			android:id="@+id/dismiss_attention_view"
			android:layout_alignTop="@id/dismiss_view"
			android:layout_alignStart="@id/dismiss_view"
			android:alpha="0.3"
			android:backgroundTint="@color/white"
			/>

		<!-- Snooze -->
		<RelativeLayout
			style="@style/My.Alarm.Active.SnoozeDismissButton"
			android:id="@+id/snooze_view"
			android:layout_alignParentStart="true"
			android:layout_centerVertical="true"
			android:layout_marginStart="@dimen/tiny"
			android:backgroundTint="@color/gray_light"
			android:gravity="center_vertical">

			<ImageView
				android:id="@+id/snooze_icon"
				android:layout_width="@dimen/isz_large"
				android:layout_height="@dimen/isz_large"
				android:layout_centerHorizontal="true"
				android:src="@drawable/snooze"
				android:contentDescription="@string/cd_snooze_alarm"
				/>

			<TextView
				android:id="@+id/snooze_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_below="@id/snooze_icon"
				android:layout_centerHorizontal="true"
				android:textColor="@color/white"
				android:textSize="@dimen/tsz_tiny"
				android:textStyle="bold"
				android:text="@string/action_alarm_snooze"
				/>
		</RelativeLayout>

		<!-- Dismiss -->
		<RelativeLayout
			style="@style/My.Alarm.Active.SnoozeDismissButton"
			android:id="@+id/dismiss_view"
			android:layout_alignParentEnd="true"
			android:layout_centerVertical="true"
			android:layout_marginEnd="@dimen/tiny"
			android:backgroundTint="@color/orange"
			android:gravity="center_vertical">

			<ImageView
				android:id="@+id/dismiss_icon"
				android:layout_width="@dimen/isz_dismiss_large"
				android:layout_height="@dimen/isz_dismiss_large"
				android:layout_centerHorizontal="true"
				android:src="@drawable/dismiss"
				android:contentDescription="@string/cd_dismiss_alarm"
				/>

			<TextView
				android:id="@+id/dismiss_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_below="@id/dismiss_icon"
				android:layout_centerHorizontal="true"
				android:textColor="@color/white"
				android:textSize="@dimen/tsz_tiny"
				android:textStyle="bold"
				android:text="@string/action_alarm_dismiss"
				/>
		</RelativeLayout>
	</RelativeLayout>

	<!-- Music and warning -->
	<RelativeLayout
		android:id="@+id/music_and_warning_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/normal"
		android:layout_marginEnd="@dimen/normal"
		android:animateLayoutChanges="true"
		app:layout_constraintBottom_toBottomOf="parent">

		<!-- Dummy -->
		<TextView
			style="@style/My.Alarm.Active.MusicAndWarning.Dummy"
			android:id="@+id/music_dummy"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerHorizontal="true"
			android:text=""
			/>

		<!-- Music -->
		<RelativeLayout
			style="@style/My.Alarm.Active.MusicAndWarning.Container"
			android:id="@+id/music_container"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_below="@id/music_dummy"
			android:layout_centerHorizontal="true"
			android:animateLayoutChanges="true"
			android:visibility="invisible">

			<!-- Icon -->
			<ImageView
				android:id="@+id/music_icon"
				android:layout_width="@dimen/isz_normal"
				android:layout_height="@dimen/isz_normal"
				android:layout_centerVertical="true"
				android:src="@drawable/music_note"
				android:contentDescription="@string/cd_current_alarm_media_playing"
				/>

			<!-- Title -->
			<TextView
				style="@style/My.Alarm.Active.MusicAndWarning.MusicTitle"
				android:id="@+id/music_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_toEndOf="@id/music_icon"
				android:text=""
				/>

			<!-- Artist -->
			<TextView
				style="@style/My.Alarm.Active.MusicAndWarning.MusicArtist"
				android:id="@+id/music_artist"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignStart="@id/music_title"
				android:layout_below="@id/music_title"
				android:text=""
				android:visibility="gone"
				/>
		</RelativeLayout>

		<!-- Warning -->
		<TextView
			style="@style/My.Alarm.Active.MusicAndWarning.Warning"
			android:id="@+id/selected_alarm_song_not_available_warning"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_below="@id/music_container"
			android:gravity="center_horizontal"
			android:text="@string/message_selected_alarm_song_not_available"
			android:visibility="invisible"
			/>
	</RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
