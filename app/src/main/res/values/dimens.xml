	<!-- Clock with hands, on the alarm screen -->
	<dimen name="analog_clock_size">200dp</dimen>
	<!-- The dial in landscape, where the screen is short: about the height the
		digits take there, so that nothing under it has to move -->
	<dimen name="analog_clock_size_land">100dp</dimen>
	<dimen name="analog_clock_top_land">8dp</dimen>
	<!-- Air between the date and the dial beside it, in landscape -->
	<dimen name="analog_clock_date_side_gap">16dp</dimen>
	<!-- About two centimetres: 160dp is an inch, so 2cm is a shade under 126dp -->
	<dimen name="bottom_halo_height">126dp</dimen>
	<!-- The rail the sun travels along, under the next alarm line -->
	<dimen name="next_alarm_track_height">36dp</dimen>
	<!-- Space under the dial, which unlike the digits has no descender to breathe with -->
	<dimen name="analog_clock_date_gap">32dp</dimen>

	<!-- How far under the guideline the dial starts. The digits get this from
		their own margin, which a dial cannot borrow: the view the dial hangs from
		is GONE while the dial is on screen, and a gone view drops its margin -->
	<dimen name="analog_clock_top">40dp</dimen>

	<!-- Air between the clock and the date, the name and the phrase under it -->
	<dimen name="clock_text_gap">20dp</dimen>

