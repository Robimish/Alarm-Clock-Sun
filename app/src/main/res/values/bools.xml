<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- App -->
	<bool name="default_app_start_statistics">true</bool>
	<bool name="default_app_should_refresh_main_activity">false</bool>
	<bool name="default_app_should_write_to_log">false</bool>
	<bool name="default_was_app_supported">false</bool>

	<!-- Card -->
	<bool name="default_card_is_measured">false</bool>
	<bool name="default_expand_new_alarm">true</bool>

	<!-- Notifications -->
	<bool name="default_missed_alarm">true</bool>

	<!-- Miscellaneous -->
	<bool name="default_use_new_alarm_screen">true</bool>
	<bool name="default_use_simple_alarm_screen">false</bool>
	<bool name="default_alarm_screen_show_alarm_name">true</bool>
	<bool name="default_alarm_screen_show_current_date_and_time">true</bool>
	<bool name="default_alarm_screen_show_music_info">true</bool>
	<bool name="default_alarm_screen_battery_saver">false</bool>
	<bool name="default_misc_should_toggle_alarms_with_airplane_mode">false</bool>

	<!-- Appearance -->
	<bool name="default_show_hide_vibrate_button">true</bool>
	<bool name="default_show_hide_nfc_button">true</bool>
	<bool name="default_show_hide_flashlight_button">true</bool>
	<bool name="default_show_hide_dawn_button">true</bool>
	<bool name="default_style_should_show_card_button_labels">true</bool>

	<bool name="default_analog_clock">false</bool>
	<bool name="default_shake_to_say_time">false</bool>
	<bool name="default_wave_to_say_time">false</bool>

	<!-- Whether the alarm list rearranges itself, which brings whatever rings next
	     to the top -->
	<bool name="default_auto_sort_alarms">false</bool>

	<!-- Whether the minutes are said as a clock face, where "4:05" needs its leading
	     zero, or as a plain number, where "05" would be read out as "zero five" -->
	<!-- Whether the light comes back on its own after a tap during the dawn -->
	<bool name="default_dawn_reveal_return">true</bool>

	<!-- Whether the screen going off dismisses the alarm while it rings -->
	<bool name="default_power_dismiss">false</bool>
	<bool name="default_record_statistics">false</bool>

	<bool name="tts_should_pad_minutes">true</bool>
	<!-- Say "in the morning / afternoon / evening" after a 12 hour clock instead of
		AM or PM, which only English says -->
	<bool name="tts_use_day_parts">false</bool>
</resources>
